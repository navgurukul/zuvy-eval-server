# Server
NODE_ENV=production
PORT=5000
BASE_URL=http://localhost:5000

# Database
DB_HOST=<postgres-hostname>
DB_PORT=5432
DB_NAME=<postgres-database>
DB_USER=<postgres-user>
DB_PASS=<postgres-password>
# Same as zuvy-server: set to "stage" to use the stage schema. Unset/anything else uses main (dev and prod).
ENV_NOTE=

# AWS S3
S3_ACCESS_KEY_ID=<aws-access-key-id>
S3_SECRET_KEY_ACCESS=<aws-secret-access-key>
S3_BUCKET_NAME=<s3-bucket-name>
S3_REGION=<aws-region>

# Auth
JWT_SECRET_KEY=<jwt-secret>
JWT_EXPIRATION=1d

# AI Providers
GOOGLE_GENAI_API_KEY=<google-genai-key>
DEEPSEEK_API_KEY=<deepseek-key>
OPENAI_KEY=<openai-key>
# Fallback model used when OpenAI fails. Defaults to gemini-2.5-flash.
# The old default, gemini-pro, has been retired and 404s.
# GEMINI_MODEL=gemini-2.5-flash

# Question generation: answer verification
#
# Every generated question is re-solved by a model that cannot see the keyed
# answer, and the question is dropped when the two disagree or when the
# verifier finds no option matching its answer. This is what stops a question
# being stored with the wrong option marked correct.
#
# Off means questions are stored on the generator's word alone. It roughly
# halves the LLM cost of generation and reinstates the failure it exists to
# prevent, so turn it off deliberately or not at all.
# VERIFY_GENERATED_ANSWERS=true
#
# Which provider verifies. Defaults to genai, so the check does not run on the
# same model that wrote the question and inherit its blind spots. Falls back to
# the other provider automatically, so an unconfigured or failing Gemini
# degrades to same-model checking rather than to none.
#
# GOOGLE_GENAI_API_KEY above must be set for the default to do anything useful.
# Confirm the provider actually works before trusting it:
#   node scripts/preflight-verifier.js --confirm
# An unreadable verifier reply keeps every question, so a broken verifier looks
# exactly like a clean run.
# VERIFIER_PROVIDER=genai

# Misc
ID=<optional-internal-id>

# Queue (BullMQ / Redis)
# REDIS_HOST / REDIS_PORT are set directly in the docker-compose environment block.
# BULLMQ_PREFIX MUST be unique per stack sharing that Redis instance (e.g. dev vs stage),
# otherwise their workers will race for each other's jobs and silently process them
# into the wrong environment's database.
BULLMQ_PREFIX=zuvy-eval-dev
# Vector store
# Which backend VectorService talks to. One of: qdrant | opensearch | dual | pinecone.
# Unset or unrecognised falls back to qdrant.
VECTOR_DB=qdrant
# Amazon OpenSearch Serverless collection endpoint. Required when VECTOR_DB is
# opensearch or dual; the app fails to start without it. Scheme is optional.
# OPENSEARCH_HOST=<collection-id>.<region>.aoss.amazonaws.com
# Region used to sign OpenSearch requests. Defaults to ap-south-1.
# AWS_REGION=ap-south-1
# Convert OpenSearch's 1/(1+distance) score back to a raw cosine value so that
# thresholds tuned against Qdrant keep their meaning. Defaults to true; set to
# "false" only if you want the raw OpenSearch score.
# OPENSEARCH_NORMALIZE_SCORES=true
# VECTOR_DB=dual only: which store serves reads. One of: qdrant | opensearch.
# Defaults to qdrant. Writes always go to both.
# VECTOR_READ_FROM=qdrant
# VECTOR_DB=dual only: also query the non-serving store and log result overlap
# and latency, without affecting the response. Defaults to false.
# VECTOR_SHADOW_COMPARE=false
#
# NOTE: AWS credentials for OpenSearch are NOT read from this file. The client
# uses the default AWS credential chain, which resolves the EC2/ECS instance
# role in deployed environments. Do not add AWS_ACCESS_KEY_ID or
# AWS_SECRET_ACCESS_KEY here. (S3_* above is a separate, pre-existing config.)

